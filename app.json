{
  "expo": {
    "name": "Kayro Farms",
    "slug": "kayro-farms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kayro-farms-mark.png",
    "scheme": "kayrofarms",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/kayro-farms-mark.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/kayro-farms-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kayro.farms"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/kayro-farms-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/kayro-farms-mark.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6ea91084-f107-47a7-8585-b63bce6c4c2a"
      }
    }
  }
}
